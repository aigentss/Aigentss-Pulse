# ============================================
# Aigents Pulse v3.0 - Environment Variables
# ============================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# DO NOT COMMIT .env TO GIT!

# ----- Fernet Encryption Key -----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# ----- SMTP Configuration -----
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Encrypted credentials (encrypt with Fernet before storing)
# Use the encrypt_credential.py helper script
SMTP_USER_ENC=your_encrypted_email_here
SMTP_PASS_ENC=your_encrypted_password_here

# ----- Alert Recipients -----
ALERT_EMAIL=alerts@example.com

# ----- Optional: Tailscale (Phase 2) -----
# TAILSCALE_AUTH_KEY=tskey-auth-xxxxx
