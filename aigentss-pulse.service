[Unit]
Description=Aigentss Pulse - Infrastructure Core (Unified)
After=network.target

[Service]
User=Rattio
WorkingDirectory=/Users/Rattio/rfid_rgb_app/aigents/2026/DevOps/MonitorVPS
# Start via Streamlit (Headless) - Monitor auto-starts in background thread
ExecStart=/usr/local/bin/streamlit run app.py --server.port=8501 --server.headless=true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
